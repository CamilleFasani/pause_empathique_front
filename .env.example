# URL appelée par le navigateur.
# Développement local : /api/v1 pour passer par le proxy Vite
# Staging, si front/API sont séparés : https://staging.pause-empathique.fr/api/v1
VITE_API_URL=/api/v1

# Cible réelle du proxy Vite pour les appels /api/* en développement local.
VITE_API_PROXY_TARGET=http://localhost:8000
